    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Router: create a case for every new email, check the sender, find the route.\n-- Uses temp tables; they are dropped at the end.\n\n-- 0. Create a case for every bronze email that has none yet\nINSERT INTO silver.command (case_id, gmail_id, thread_id)\nSELECT encode(sha256(convert_to(b.gmail_id, 'UTF8')), 'hex'), b.gmail_id, b.thread_id\nFROM bronze.gmail_message b\nLEFT JOIN silver.command c ON c.gmail_id = b.gmail_id\nWHERE c.gmail_id IS NULL\nON CONFLICT (case_id) DO NOTHING;\n\nDROP TABLE IF EXISTS pg_temp.tmp_lookup, pg_temp.tmp_src, pg_temp.tmp_resolved;\n\n-- 1. Every word that names a route: the route name itself and its aliases\nCREATE TEMP TABLE tmp_lookup AS\nSELECT lower(route) AS word, route\nFROM ctl.route\nWHERE enabled\nUNION\nSELECT a.alias, a.route\nFROM ctl.route_alias a\nJOIN ctl.route r ON r.route = a.route\nWHERE r.enabled;\n\n-- 2. New cases with the three fields the router needs\nCREATE TEMP TABLE tmp_src AS\nSELECT c.case_id,\n       lower(b.message->'from'->'value'->0->>'address') AS sender,\n       substring(lower(b.message->'to'->'value'->0->>'address') from '\\+([^@]+)@') AS plus_word,\n       lower((regexp_split_to_array(\n                btrim(regexp_replace(coalesce(b.message->>'subject', ''),\n                                     '^\\s*((re|fwd?|aw|wg)\\s*:\\s*)+', '', 'i')),\n                '\\s+'))[1]) AS subject_word\nFROM silver.command c\nJOIN bronze.gmail_message b ON b.gmail_id = c.gmail_id\nWHERE c.status = 'received';\n\n-- 3. Owner from the allow-list; route from plus-address, then subject word, then help\nCREATE TEMP TABLE tmp_resolved AS\nSELECT s.case_id,\n       o.owner_id,\n       coalesce(l1.route, l2.route, 'help') AS route,\n       CASE WHEN l1.route IS NOT NULL THEN 'plus_address'\n            WHEN l2.route IS NOT NULL THEN 'subject'\n            ELSE 'fallback'\n       END AS resolved_by\nFROM tmp_src s\nLEFT JOIN ctl.owner_address o ON o.address = s.sender\nLEFT JOIN tmp_lookup l1 ON l1.word = s.plus_word\nLEFT JOIN tmp_lookup l2 ON l2.word = s.subject_word;\n\n   -- 4. Write the result; unknown senders become 'failed' and get no route\n   UPDATE silver.command c\n   SET owner_id    = r.owner_id,\n       route       = CASE WHEN r.owner_id IS NULL THEN NULL ELSE r.route END,\n       resolved_by = CASE WHEN r.owner_id IS NULL THEN NULL ELSE r.resolved_by END,\n       status      = CASE WHEN r.owner_id IS NULL THEN 'failed' ELSE 'routed' END,\n       summary     = CASE WHEN r.owner_id IS NULL THEN 'sender not on the allow-list' END,\n       n8n_execution_id = '{{ $execution.id }}'\n   FROM tmp_resolved r\n   WHERE c.case_id = r.case_id\n   RETURNING c.case_id, c.gmail_id, c.thread_id, c.owner_id, c.route, c.resolved_by, c.status;\n\nDROP TABLE tmp_lookup, tmp_src, tmp_resolved;",
        "options": {}
      },
